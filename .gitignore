# Python
venv/
__pycache__/
*.pyc
backend-django/db.sqlite3

# Node
node_modules/
frontend-react/dist/

# macOS
.DS_Store

# Env files with real secrets — only .env.example is ever committed
.env
**/.env

# Go — compiled binaries, not source. `worker` is the Linux/container
# build output (built fresh by backend-go/Dockerfile); `worker.exe` is
# what a local `go build` produces on Windows. Neither belongs in git —
# spotted `worker.exe` already staged in the very first `git add .`
# before this pattern existed (2026-08-12).
backend-go/worker
backend-go/*.exe

# Uploaded media (menu icons, branding logo) — bind-mounted into the
# django container via docker-compose.yml for persistence across
# rebuilds/machine migration (2026-08-08). The folder itself is tracked
# (via .gitkeep below) so it exists before the first upload; its runtime
# contents are not source and shouldn't be committed.
backend-django/media/*
!backend-django/media/.gitkeep

# graphify knowledge graph output — build artifact, rebuilt with `graphify extract`
graphify-out/


# Runtime data, bind-mounted into the containers (2026-08-23). Kept in the
# project folder rather than a Docker named volume so it travels with the
# directory when the team copies it, but must never be committed.
/data/

# Local drive-test sample files (real NT network data, often large) —
# handed over for parser development/verification, never committed.
/samples/

# Claude session scratch notes / tool output -- not part of the project.
/memory/
frontend-react/tsc-out.txt
