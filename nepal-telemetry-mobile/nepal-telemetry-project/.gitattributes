# Normalize all text files to LF in the repository; check them out with
# each platform's native line endings.
* text=auto eol=lf

# Explicit text types (kept LF in the repo regardless of local settings)
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
*.properties text eol=lf
*.gradle  text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Scripts that must keep a specific ending to run
gradlew   text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary — never touch line endings
*.jar     binary
*.png     binary
*.jpg     binary
*.keystore binary
*.jks     binary
