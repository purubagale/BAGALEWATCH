<resources>
    <!-- Button styles (2026-10-04; NT blue on the light theme since 2026-10-19). -->
    <style name="Widget.App.OutlinedButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="rippleColor">@color/brand_accent</item>
        <item name="cornerRadius">3dp</item>
    </style>

    <style name="Widget.App.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="rippleColor">@color/brand_primary</item>
    </style>

    <style name="Base.Theme.NetTelemetryDemo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.App.TextButton</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
    </style>

    <!-- Android 12 and later add the opening screen in values-v31. -->
    <style name="Theme.NetTelemetryDemo" parent="Base.Theme.NetTelemetryDemo" />

    <!-- Bottom tabs (2026-10-31): the selected tab sits on a light blue pill. -->
    <style name="Widget.App.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.Indicator</item>
    </style>

    <style name="Widget.App.BottomNav.Indicator" parent="">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">@color/surface_card_alt</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CellRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/bg_row_divider</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="CellLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CellValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Screen header (2026-10-19): a deep blue band that continues the status
         bar, with the title in gold capitals, as in the Nepal Telecom app. The
         negative margins cancel the screen's 16dp padding. -->
    <style name="ScreenHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-16dp</item>
        <item name="android:layout_marginEnd">-16dp</item>
        <item name="android:layout_marginTop">-16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@color/brand_primary</item>
        <!-- The gold emblem, as in the web application's header (2026-10-31). -->
        <item name="android:drawableStart">@drawable/ic_header_logo</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/brand_accent</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
