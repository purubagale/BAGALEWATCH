<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later (2026-10-14): nothing from this app goes to cloud
  backup or to a new phone. Its data is a device ID, an upload queue and
  registration state that belong to this phone only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
