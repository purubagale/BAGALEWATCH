<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions declared here - ACCESS_FINE_LOCATION, READ_PHONE_STATE,
      ACCESS_NETWORK_STATE and INTERNET all come from
      netplanning-telemetry-sdk's own manifest and are merged in automatically
      because :app depends on that module. See that module's AndroidManifest.xml
      if this ever needs to be verified directly.
    -->

    <!-- Wi-Fi scan for the phone-only Wi-Fi tab (2026-10-04). Results stay on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NetTelemetryDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TraceMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".TraceActionReceiver"
            android:exported="false" />

        <service
            android:name=".TraceSharingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".LiveParamsActivity"
            android:exported="false" />

    </application>

</manifest>
