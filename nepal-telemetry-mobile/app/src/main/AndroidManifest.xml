<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions declared here - ACCESS_FINE_LOCATION, READ_PHONE_STATE,
      ACCESS_NETWORK_STATE and INTERNET all come from
      netplanning-telemetry-sdk's own manifest and are merged in automatically
      because :app depends on that module. See that module's AndroidManifest.xml
      if this ever needs to be verified directly.
    -->

    <!-- Wi-Fi scan for the phone-only Wi-Fi tab (2026-10-04). Results stay on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Speed test over mobile data while on Wi-Fi (2026-10-14). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Site photo (2026-10-11). Asked for only when that screen is opened. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Help improve NTC's network (2026-10-29): a rough area (about 500 m) with the
         readings taken while the app is closed. Asked for only after the person
         turned those readings on, and optional; without it no area is sent. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NetTelemetryDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TraceMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".TraceActionReceiver"
            android:exported="false" />

        <service
            android:name=".TraceSharingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Collector edition only (2026-10-14): a reading every minute while sharing. -->
        <service
            android:name=".CollectorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".SitePhotoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LiveParamsActivity"
            android:exported="false" />

        <!-- Signs the SDK's uploads with this phone's key once registered (2026-10-14). -->
        <provider
            android:name=".SdkSignerProvider"
            android:authorities="${applicationId}.sdksigner"
            android:exported="false" />

    </application>

</manifest>
