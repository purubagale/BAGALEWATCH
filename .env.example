# THE one .env for this whole stack. Copy to .env and fill in.
#   cp .env.example .env
# Read by BOTH compose itself (for ${...} interpolation) and, via
# `env_file: ./.env`, by the django and node-gateway containers. There are
# no per-service .env files any more (2026-08-21) — backend-django/.env and
# backend-node/.env used to duplicate half of this. The only other env file
# in the repo is frontend-react/.env, which is OPTIONAL and works
# differently: Vite reads it at image BUILD time, not through compose.
# Never commit a real .env — it's gitignored, keep it that way.

# ── Django ───────────────────────────────────────────────────────────
# ONLY the literal `1` turns debug on — settings.py parses this as
# `os.environ.get('DEBUG', '0') == '1'`, so `True`/`true`/`yes` all
# silently mean DEBUG=False. Deliberately strict (an unexpected value
# fails closed, never open), but easy to get wrong by hand — a real .env
# on this machine said `DEBUG=True` and had been running with debug off.
DEBUG=1
SECRET_KEY=change-me-in-every-real-environment
# `*` (2026-08-10 port-hiding pass) — see the real .env's own comment.
# Set to your server's actual LAN IP(s)/hostname(s) instead if you'd
# rather keep an explicit allowlist.
ALLOWED_HOSTS=*

# Mostly moot after the 2026-08-10 port-hiding pass (same-origin requests
# through nginx never trigger CORS). Note the trailing S: this is django's
# var. The node gateway's own, unset here because its default already
# matches, is the singular CORS_ALLOWED_ORIGIN.
CORS_ALLOWED_ORIGINS=http://localhost:5180

# Add your real LAN origin here too (comma-separated) if Django admin
# needs to be reachable from a machine other than the Docker host.
CSRF_TRUSTED_ORIGINS=http://localhost:5180

# ── Postgres ─────────────────────────────────────────────────────────
# A DEDICATED database for the v2 stack. Never points at the v1 system's
# bagalewatch.db (that's SQLite anyway, and is never touched by this
# project — see docs/RUNBOOK.md "Isolation guarantees").
POSTGRES_DB=dtwatch_db
POSTGRES_USER=dtwatch_user
POSTGRES_PASSWORD=change-me-to-a-real-secret
# CAREFUL: docker-compose.yml sets `POSTGRES_HOST: db` under django's and
# go-worker's `environment:`, which WINS over whatever is set here — so
# putting an external server's IP in this line alone does NOT point the
# app at it. Pointing this stack at an external Postgres means overriding
# those two `environment:` entries as well (and probably disabling the
# bundled `db` service), the same way docker-compose.shared-redis.yml
# overrides the Redis wiring.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Node gateway ─────────────────────────────────────────────────────
# Both of this service's remaining vars (PORT=8090, CORS_ALLOWED_ORIGIN=
# http://localhost:5180) are left unset on purpose — backend-node/src/
# server.js already defaults to exactly those values, and the Dockerfile
# EXPOSEs 8090. Set PORT here only if you also change that EXPOSE and the
# frontend nginx proxy target.

# ── Redis ────────────────────────────────────────────────────────────
# Deliberately NOT set here. docker-compose.yml sets REDIS_URL under each
# service's `environment:` (django gets DB 1 as its cache backend, the
# node gateway and go-worker share DB 0), which overrides anything in this
# file — so a stale REDIS_URL line here is silently ignored rather than
# quietly pointing a service somewhere unexpected.

# ── Shared Redis (2026-08-21) ────────────────────────────────────────
# Only needed if you point this stack at the workspace-wide Redis in
# d:\Projects\shared-redis instead of the `redis` service bundled in
# docker-compose.yml. On a standalone/customer deploy, leave both of
# these OUT — the bundled Redis is used and nothing else is required.
#
# COMPOSE_FILE makes a plain `docker compose up` in this folder apply
# docker-compose.shared-redis.yml on top of the base file, so you don't
# have to repeat `-f ... -f ...` on every command. COMPOSE_PATH_SEPARATOR
# is set explicitly because Compose defaults it to ':' on Linux/WSL but
# ';' on Windows — pinning it means the same .env works whichever shell
# you drive Docker from.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-redis.yml
#
# Must match REDIS_PASSWORD in d:\Projects\shared-redis\.env.
# SHARED_REDIS_PASSWORD=copy-from-shared-redis/.env
# ── Keycloak SSO (2026-08-23) ────────────────────────────────────────
# Full design + the Keycloak-side setup steps:
#   docs/superpowers/specs/2026-08-23-keycloak-sso-design.md
#
# SSO stays completely dark until KEYCLOAK_SSO_ENABLED is on AND issuer,
# client id, secret and redirect URI are all filled in. That is on
# purpose: a half-configured client would redirect to Keycloak and then
# fail at the callback, after the user has already typed their password.
KEYCLOAK_SSO_ENABLED=0
KEYCLOAK_ISSUER=https://sso.ntc.net.np/realms/company
KEYCLOAK_CLIENT_ID=dtwatch
KEYCLOAK_CLIENT_SECRET=
# Must match a Redirect URI on the Keycloak client EXACTLY, trailing
# slash included, or Keycloak rejects the request before showing a login
# form. Note this is OUR callback, not the SPA's route.
KEYCLOAK_REDIRECT_URI=http://dtwatch.ntc.net.np:5180/api/v2/auth/sso/callback/

# Access gate. Membership of this ONE group is what entitles someone to
# DT-WATCH. Deliberately not one of the shared realm groups
# (platform-admins/developers/viewers) — those also drive Grafana, GitLab
# and Rocket.Chat, so gating on one would hand DT-WATCH to everyone who
# holds it. Leaving KEYCLOAK_REQUIRED_GROUP empty disables the gate
# entirely and lets any realm user in; almost never what you want.
KEYCLOAK_REQUIRED_GROUP=dtwatch
KEYCLOAK_GROUPS_CLAIM=groups

# Keycloak group -> DT-WATCH role. Configuration rather than code so the
# realm's exact group strings don't have to be guessed at build time.
# Anyone in the gate group but in no group listed here gets
# KEYCLOAK_DEFAULT_ROLE, so a typo under-privileges rather than handing
# out superadmin. Re-applied on EVERY login: Keycloak is the source of
# truth, so editing an SSO user's role in the app will not stick.
KEYCLOAK_ROLE_GROUP_MAP=superadmin:superadmin,platform-admins:admin,viewers:viewer
KEYCLOAK_DEFAULT_ROLE=viewer

# Local username/password login. ON by default, so adding SSO changes
# nothing about how anyone signs in today. Set to 0 for the SSO-only
# cutover once SSO is proven — reversible, and no code change or rebuild.
# Note Django admin at /admin/ has its own session login and is NOT
# affected by this flag, which is a useful break-glass but also a
# password surface worth restricting once SSO is mandatory.
LOCAL_LOGIN_ENABLED=1

# SSO sessions get a shorter refresh lifetime than the 12h local default,
# because DT-WATCH mints its own tokens: someone disabled in Keycloak
# keeps working DT-WATCH tokens until their refresh expires. 1h bounds
# that without storing a Keycloak credential at rest per session.
SSO_REFRESH_TOKEN_LIFETIME=3600
