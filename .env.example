# Root-level compose vars. Copy to .env and fill in.
POSTGRES_DB=bagalewatch_v2
POSTGRES_USER=bagalewatch
POSTGRES_PASSWORD=change-me-to-a-real-secret
# VITE_DJANGO_API_URL/VITE_NODE_GATEWAY_URL removed here (2026-08-10
# port-hiding pass) — see the real .env's own comment.

# pgAdmin (2026-08-20 — web GUI for Postgres, http://localhost:5050 once
# running, loopback-only — see docker-compose.yml's `pgadmin` service
# comment). Login email can be anything; it's just pgAdmin's own account,
# unrelated to this app's users.
PGADMIN_EMAIL=admin@bagalewatch.app
PGADMIN_PASSWORD=change-me-to-a-real-secret
