# Copy to .env and fill in for local/dev use. Never commit a real .env.
DEBUG=1
SECRET_KEY=change-me-in-every-real-environment
# `*` (2026-08-10 port-hiding pass) — see the real .env's own comment.
# Set to your server's actual LAN IP(s)/hostname(s) instead if you'd
# rather keep an explicit allowlist.
ALLOWED_HOSTS=*

# Postgres — a DEDICATED database for the v2 stack. Never points at the
# v1 system's bagalewatch.db (that's SQLite anyway, and is never touched
# by this project — see docs/RUNBOOK.md "Isolation guarantees").
POSTGRES_DB=bagalewatch_v2
POSTGRES_USER=bagalewatch
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Mostly moot after the 2026-08-10 port-hiding pass — see the real .env's
# own comment (same-origin requests through nginx never trigger CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5180

# Add your real LAN origin here too (comma-separated) if Django admin
# needs to be reachable from a machine other than the Docker host.
CSRF_TRUSTED_ORIGINS=http://localhost:5180

# Shared cache backend (2026-08-08 scaling pass) — see .env's own comment
# for why this needs to be Redis, not the LocMemCache default, once more
# than one gunicorn worker process is running.
REDIS_URL=redis://redis:6379/1
